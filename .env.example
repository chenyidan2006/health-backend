# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=health_app
DB_PASSWORD=请替换为强密码
DB_NAME=health_monitor
DB_TIMEZONE=+08:00

# 后端服务端口（原始波形接收器使用 3000，本服务使用 3002）
PORT=3002

# 登录令牌；生产环境必须替换为长随机字符串
JWT_SECRET=请替换为长随机字符串

# 微信登录（不用时可留空）
WECHAT_APPID=
WECHAT_SECRET=

# 阿里云短信（不用时可留空）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# AI 健康报告（不用时可留空）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash

# 原始波形目录；不设置时后端按内置候选路径查找
# RAW_DATA_DIR=D:\project\PPG\算法\服务器部署\raw-receiver\received

# 日志级别
LOG_LEVEL=info
